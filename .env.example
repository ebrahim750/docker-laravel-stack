# --- application --------------------------------------------------------------
COMPOSE_PROJECT_NAME=laravel
APP_IMAGE_TAG=local
PHP_VERSION=8.4
UID=1000
GID=1000

# --- ports --------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
CERT_DIR=./docker/certs

# --- laravel ------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# --- database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- redis --------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- queue --------------------------------------------------------------------
QUEUE_NAMES=default
QUEUE_TRIES=3
